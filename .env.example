# ─────────────────────────────────────────────────────────────
# Global Aviation Services Directory — frontend configuration
# Copy to .env.local. Every integration defaults to "mock" so the
# site runs with zero keys. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for metadata / canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Platform backend (/api/v1) ───────────────────────────────
# mock = in-repo demo data; api = call the backend at API_BASE_URL
DATA_SOURCE=mock
API_BASE_URL=http://localhost:4000
# Browser-side forms & auth: mock = simulated locally; api = call the backend
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ── Aviation weather (METAR / TAF) ───────────────────────────
# mock | aviationweather (free, no key) | checkwx (key required)
WEATHER_PROVIDER=mock
CHECKWX_API_KEY=

# ── NOTAMs ───────────────────────────────────────────────────
# mock | faa  (register at https://api.faa.gov)
NOTAM_PROVIDER=mock
FAA_NOTAM_CLIENT_ID=
FAA_NOTAM_CLIENT_SECRET=

# ── Airport reference data (runways, frequencies) ────────────
# mock | airportdb  (token from https://airportdb.io)
AIRPORT_DATA_PROVIDER=mock
AIRPORTDB_API_TOKEN=

# ── Maps (airport location, satellite view) ──────────────────
# osm (OpenStreetMap, no key) | google (Maps Embed API key)
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Timeout for every third-party call (ms)
INTEGRATION_TIMEOUT_MS=8000
